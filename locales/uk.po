msgstr "Одразу після кожного диктування"

#: src/window.rs:1118
msgid "After 2 minutes"
msgstr "Через 2 хвилини"

#: src/window.rs:1119
msgid "After 5 minutes"
msgstr "Через 5 хвилин"

#: src/window.rs:1120
msgid "After 10 minutes"
msgstr "Через 10 хвилин"

#: src/window.rs:1121
msgid "After 15 minutes"
msgstr "Через 15 хвилин"

#: src/window.rs:1122
msgid "After 60 minutes"
msgstr "Через 60 хвилин"

#: src/window.rs:1128
msgid "Until Wavo quits"
msgstr "До виходу з Wavo"

#. Translators: how long to keep the history.
#: src/window.rs:1134
msgid "Forever"
msgstr "Завжди"

#: src/window.rs:1135
msgid "The last 100 dictations"
msgstr "Останні 100 диктувань"

#: src/window.rs:1136
msgid "The last 1,000 dictations"
msgstr "Останні 1 000 диктувань"

#: src/window.rs:1137
msgid "The last 10,000 dictations"
msgstr "Останні 10 000 диктувань"

#: src/window.rs:1138
msgid "3 days"
msgstr "3 дні"

#: src/window.rs:1139
msgid "2 weeks"
